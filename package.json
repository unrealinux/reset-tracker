{
  "name": "reset-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Track official Codex, Claude and Grok usage-limit reset announcements: history, stats, forecasts, feeds and notifications.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "start:standalone": "node .next/standalone/server.js",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:seed": "node scripts/seed.mjs",
    "db:reset": "node scripts/seed.mjs --force",
    "seed:harvest": "node scripts/harvest.mjs",
    "poll": "node scripts/poll.mjs",
    "notify": "node scripts/notify.mjs",
    "mcp": "node mcp/server.mjs",
    "selftest": "node scripts/selftest.mjs",
    "keys": "node scripts/keys.mjs",
    "demo": "node scripts/demo.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.6.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3"
  }
}
