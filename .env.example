# ---------------------------------------------------------------------------
# reset-tracker environment
# Copy to .env.local and fill in the values you need.
# Everything has a safe development default, so the site boots with no config.
# ---------------------------------------------------------------------------

# Directory for the SQLite database file (default: ./data)
DATA_DIR=./data

# Public site origin, used for canonical URLs, feeds and VAPID audience.
SITE_URL=http://localhost:3000

# Secret required by /api/cron/* endpoints (header: x-cron-secret).
CRON_SECRET=change-me

# Admin panel password + cookie signing secret.
ADMIN_PASSWORD=admin
ADMIN_SECRET=change-me-too

# ---------------------------------------------------------------------------
# Scheduling
# ---------------------------------------------------------------------------
# Set to 1 on a single-instance host with no external cron (Zeabur, Railway,
# Render, Fly, a lone container). Leave it off when running several replicas.
ENABLE_SCHEDULER=0
SCHEDULER_INTERVAL_MINUTES=60

# ---------------------------------------------------------------------------
# Web Push (VAPID). Generate a keypair with:  npm run keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---------------------------------------------------------------------------
# Ingestion sources
# ---------------------------------------------------------------------------
# Pull Codex history from the public codex-resets.com API.
SOURCE_CODEX_RESETS_API=1

# Optional third-party X/Twitter mirror (Nitter-compatible RSS) used to poll
# the announcement accounts directly. Leave empty to disable.
NITTER_BASE_URL=

# ---------------------------------------------------------------------------
# Notification delivery (all optional)
# ---------------------------------------------------------------------------
# Telegram bot used to post to a channel/group when a new reset is recorded.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public channel/group invite link shown in the "Remind me" panel.
TELEGRAM_CHANNEL_URL=

# SMTP settings for the email digest (optional).
SMTP_URL=
MAIL_FROM=resets@example.com
